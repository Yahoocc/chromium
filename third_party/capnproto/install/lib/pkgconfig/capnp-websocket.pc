prefix=/home/wisdom/Desktop/chromium_local/chromium/src/third_party/capnproto/install
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Cap'n Proto WebSocket RPC
Description: WebSocket MessageStream for Cap'n Proto
Version: 1.1.0
Libs: -L${libdir} -lcapnp-websocket
Requires: capnp = 1.1.0 capnp-rpc = 1.1.0 kj = 1.1.0 kj-async = 1.1.0 kj-http = 1.1.0
Cflags: -I${includedir}
